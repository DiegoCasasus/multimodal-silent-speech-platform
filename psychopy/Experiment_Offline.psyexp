        <Param val="import * as random from 'random';&amp;#10;p_target = 0.1;&amp;#10;is_target = (Math.random.random() &lt; p_target);&amp;#10;if (is_target) {&amp;#10;    cal_char = Math.random.randint(0, 9).toString();&amp;#10;    tag = &quot;T&quot;;&amp;#10;} else {&amp;#10;    cal_char = chr(Math.random.randint(ord(&quot;A&quot;), ord(&quot;Z&quot;)));&amp;#10;    tag = &quot;NT&quot;;&amp;#10;}&amp;#10;calStim.setText(cal_char);&amp;#10;psychoJS.window.callOnFlip(send_marker, `CAL_STIM_ON:${cal_char}:${tag}`);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
