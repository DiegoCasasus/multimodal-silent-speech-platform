        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="1.5" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="$target_word" valType="str" updates="set every repeat" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="Welcome"/>
    <Routine name="cal_instructions"/>
    <Routine name="Start_record"/>
    <LoopInitiator loopType="TrialHandler" name="cal">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0,1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="200" valType="num"/>
      <Param name="name" updates="None" val="cal" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="calibration"/>
    <LoopTerminator name="cal"/>
    <Routine name="Stop_record"/>
    <Routine name="Instructions_silent"/>
    <Routine name="Start_record"/>
    <LoopInitiator loopType="TrialHandler" name="break_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0,1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="10" valType="num"/>
      <Param name="name" updates="None" val="break_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <LoopInitiator loopType="TrialHandler" name="trials_silent">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'target_word': '1 (ONE)'}, {'target_word': '2 (TWO)'}, {'target_word': '3 (THREE)'}, {'target_word': '4 (FOUR)'}, {'target_word': '5 (FIVE)'}, {'target_word': 'REJOIN'}, {'target_word': 'ASSET'}, {'target_word': 'ABORT'}, {'target_word': 'FORMATION'}, {'target_word': 'REFUEL'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="Conditions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0,1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_silent" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="wait"/>
    <Routine name="read"/>
    <Routine name="trial"/>
    <LoopTerminator name="trials_silent"/>
    <Routine name="mini_break"/>
    <LoopTerminator name="break_loop"/>
    <Routine name="Stop_record"/>
    <Routine name="Instructions_imagined"/>
    <Routine name="Start_record"/>
    <LoopInitiator loopType="TrialHandler" name="break_loop2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0,1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="10" valType="num"/>
      <Param name="name" updates="None" val="break_loop2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <LoopInitiator loopType="TrialHandler" name="trials_imagined">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'target_word': '1 (ONE)'}, {'target_word': '2 (TWO)'}, {'target_word': '3 (THREE)'}, {'target_word': '4 (FOUR)'}, {'target_word': '5 (FIVE)'}, {'target_word': 'REJOIN'}, {'target_word': 'ASSET'}, {'target_word': 'ABORT'}, {'target_word': 'FORMATION'}, {'target_word': 'REFUEL'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="Conditions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0,1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_imagined" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="wait"/>
    <Routine name="read"/>
    <Routine name="trial"/>
    <LoopTerminator name="trials_imagined"/>
    <Routine name="mini_break"/>
    <LoopTerminator name="break_loop2"/>
    <Routine name="Stop_record"/>
    <Routine name="Finish"/>
  </Flow>
</PsychoPy2experiment>
