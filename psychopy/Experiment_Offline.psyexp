        <Param val="force_window_focus(win)&amp;#10;&amp;#10;if block == &quot;silent&quot;:&amp;#10;    current_batch = silent_batch&amp;#10;    silent_batch += 1&amp;#10;    marker_txt = &quot;SILENT_LOOP_BREAK_END&quot;&amp;#10;elif block == &quot;imagined&quot;:&amp;#10;    current_batch = imagined_batch&amp;#10;    imagined_batch += 1&amp;#10;    marker_txt = &quot;IMAGINED_LOOP_BREAK_END&quot;&amp;#10;else:&amp;#10;    current_batch = 0&amp;#10;    marker_txt = f&quot;{str(block).upper()}_LOOP_BREAK_END&quot;&amp;#10;&amp;#10;break_text = f&quot;Loop {current_batch} finished!\n\nTake a short rest, blink, and swallow.\nPress SPACEBAR to start the next 10 words.&quot;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
