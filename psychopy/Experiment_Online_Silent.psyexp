      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="200" valType="num"/>
      <Param name="name" updates="None" val="cal" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="calibration"/>
    <LoopTerminator name="cal"/>
    <Routine name="Stop_record"/>
    <Routine name="Processing_calibration"/>
    <Routine name="Instructions_silent"/>
    <Routine name="Start_record"/>
    <LoopInitiator loopType="TrialHandler" name="trials_online_silent">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'target_word': '1 (ONE)'}, {'target_word': '2 (TWO)'}, {'target_word': '3 (THREE)'}, {'target_word': '4 (FOUR)'}, {'target_word': '5 (FIVE)'}, {'target_word': 'REJOIN'}, {'target_word': 'ASSET'}, {'target_word': 'ABORT'}, {'target_word': 'FORMATION'}, {'target_word': 'REFUEL'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="Conditions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0,1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="45" valType="num"/>
      <Param name="name" updates="None" val="trials_online_silent" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="wait"/>
    <Routine name="read"/>
    <Routine name="trial"/>
    <Routine name="decode_wait"/>
    <Routine name="online_feedback"/>
    <Routine name="mini_break"/>
    <LoopTerminator name="trials_online_silent"/>
    <Routine name="Stop_record"/>
    <Routine name="Finish"/>
  </Flow>
</PsychoPy2experiment>
