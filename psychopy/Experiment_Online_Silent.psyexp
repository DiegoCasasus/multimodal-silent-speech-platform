        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Show a rest screen after every 50 completed online silent trials, except after the final trial.&amp;#10;# This is safer for long validation runs: with 450 trials, this gives about 8 rests.&amp;#10;break_every_n_trials = 50&amp;#10;try:&amp;#10;    total_silent_trials = int(trials_online_silent.nTotal)&amp;#10;except Exception:&amp;#10;    total_silent_trials = 0&amp;#10;&amp;#10;show_mini_break = (&amp;#10;    completed_online_trials &gt; 0&amp;#10;    and completed_online_trials % break_every_n_trials == 0&amp;#10;    and (total_silent_trials &lt;= 0 or completed_online_trials &lt; total_silent_trials)&amp;#10;)&amp;#10;&amp;#10;if not show_mini_break:&amp;#10;    marker_txt = None&amp;#10;    continueRoutine = False&amp;#10;else:&amp;#10;    force_window_focus(win)&amp;#10;    marker_txt = f&quot;SILENT_REST_END:{completed_online_trials}&quot;&amp;#10;    win.callOnFlip(outlet.push_sample, [f&quot;SILENT_REST_START:{completed_online_trials}&quot;])&amp;#10;    print(f&quot;[REST] {completed_online_trials} silent trials completed. Press SPACEBAR to continue.&quot;, flush=True)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
